{
  "uid": "m7-recovery-test",
  "title": "M7 - Recovery Test",
  "description": "Source-backed explicit target observations; fixture evidence remains labeled and incomplete.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "m7",
    "recovery",
    "cloudlib-task06"
  ],
  "timezone": "Asia/Jakarta",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Actual recovery drill events",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Tested target and evidence",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Dashboard follows the latest actual injection: pod-delete / kubernetes = QS05; database-loss / compose = QS06. Dry-run does not replace it. RPO and database restore stages do not apply to QS05. Run identity is in annotations and the [structured result](http://localhost:19090/result). Scrape success alone does not prove application readiness."
      }
    },
    {
      "id": 2,
      "title": "Latest run identity · startedAt",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudlib_drill_run_started_seconds{job=\"cloudlib-recovery-drill\"} * 1000",
          "instant": true,
          "legendFormat": "{{method}} · {{environment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Unknown / not observed"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Full acceptance · 1 LULUS / 0 GAGAL",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudlib_drill_complete{job=\"cloudlib-recovery-drill\"}",
          "instant": true,
          "legendFormat": "{{check}}{{stage}}{{environment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / not observed",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "GAGAL",
                  "color": "red"
                },
                "1": {
                  "text": "LULUS",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
