# Copy to reliability/.runtime/.env and fill locally. Never commit the filled file.
# Password of the existing main business database; do not change its password here.
CLOUDLIB_SOURCE_PASSWORD=
# Independent passwords for the isolated M7 PostgreSQL owner, app and worker roles.
CLOUDLIB_RECOVERY_OWNER_PASSWORD=
CLOUDLIB_RECOVERY_APP_PASSWORD=
CLOUDLIB_RECOVERY_WORKER_PASSWORD=
# Existing synthetic M7 Keycloak accounts: m7-petugas, m7-mahasiswa, m7-admin.
CLOUDLIB_PETUGAS_PASSWORD=
CLOUDLIB_MAHASISWA_PASSWORD=
CLOUDLIB_ADMIN_PASSWORD=
# Approved published application image: localhost:5001/student/cloudlib-app@sha256:...
# Obtain its actual manifest digest from the successful team delivery pipeline.
CLOUDLIB_BASELINE_IMAGE=
